[Unit]
Description=WIDS Streamlit dashboard
After=network.target wids-capture.service
Wants=wids-capture.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/wids
ExecStart=/usr/bin/python3 -m streamlit run /home/pi/wids/dashboard.py --server.port 8501 --server.address 0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
